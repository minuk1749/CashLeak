{
  "name": "cashleak-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm run dev -w @cashleak/web",
    "build": "npm run build -w @cashleak/web",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "evaluate": "npm run evaluate -w @cashleak/engine",
    "generate": "npm run generate -w @cashleak/engine",
    "detect": "npm run detect -w @cashleak/engine --"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
